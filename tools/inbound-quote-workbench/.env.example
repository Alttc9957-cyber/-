AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.2

# Local persistent product-resource memory used when Supabase is not configured,
# or when cloud publishing fails and the quote desk needs a safe fallback.
MANUAL_PRODUCT_RESOURCES_PATH=data/manual-product-resources.json

# Backward-compatible legacy names. Prefer AI_* for customer deployment.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2
